{
  "disableAllHooks": false,
  "permissions": {
    "deny": [
      "Edit(**/ConnectivityLocalSecrets.h)",
      "Edit(**/MqttLocalSecrets.h)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -d *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr merge *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -f *)",
      "PowerShell(git clean -d *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Program Files/ClaudeCode/hooks/claude_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking the command against the owner's guard"
          }
        ]
      }
    ]
  }
}
