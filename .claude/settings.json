{
  "permissions": {
    "deny": [
      "Edit(components/Fleet_Connectivity/ConnectivityLocalSecrets.h)",
      "Edit(components/Fleet_MQTT/MqttLocalSecrets.h)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -d *)",
      "Bash(git filter-branch *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -f *)",
      "PowerShell(git clean -d *)",
      "PowerShell(git filter-branch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/claude_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking the command against the project's guard"
          }
        ]
      }
    ]
  }
}
